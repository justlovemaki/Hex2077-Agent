# AI 提供商配置
# 推荐使用：OpenAI, DeepSeek, Grok, Gemini (OpenAI 兼容模式)

# 必须：你的 API Key
AI_API_KEY=sk-xxxx

# 可选：API 基础地址 (默认为 OpenAI)
# DeepSeek: https://api.deepseek.com
# Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=https://api.openai.com/v1

# 可选：使用的模型名称 (默认为 gpt-4o)
# DeepSeek: deepseek-chat
AI_MODEL=gpt-4o

# 服务配置
PORT=3000

# 速率限制配置
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# 聊天限制配置
CHAT_MAX_INPUT_LENGTH=500
CHAT_MAX_HISTORY_ROUNDS=30

# 知识库管理密码 (访问 /knowledge 时使用)
KB_PASSWORD=admin123

# OpenClaw China 适配器配置 (跨平台接入)
OPENCLAW_ENABLED=true

# 飞书 (Feishu)
FEISHU_ENABLED=false
FEISHU_APP_ID=cli_xxxxxx
FEISHU_APP_SECRET=your-secret
FEISHU_CONNECTION_MODE=websocket
# FEISHU_SEND_MARKDOWN_AS_CARD=true

# 钉钉 (DingTalk)
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=dingxxxxxx
DINGTALK_CLIENT_SECRET=your-secret
DINGTALK_CONNECTION_MODE=stream
# DINGTALK_GATEWAY_TOKEN=your-gateway-token

# QQ 机器人 (QQBot)
QQBOT_ENABLED=false
QQBOT_APP_ID=10xxxxxx
QQBOT_CLIENT_SECRET=your-secret

# 企业微信智能机器人 (WeCom Smart Bot - 内部群聊回调/长连接)
WECOM_ENABLED=false
WECOM_BOT_MODE=ws
WECOM_BOT_ID=your-bot-id
WECOM_BOT_SECRET=your-secret
# WECOM_BOT_RECEIVE_ID=your-receive-id
# WECOM_BOT_TOKEN=your-token
# WECOM_BOT_AES_KEY=your-aes-key
# WECOM_BOT_WEBHOOK_PATH=/wecom-bot

# 微信公众号 (WeChat MP - 订阅号/服务号)
WECHAT_MP_ENABLED=false
WECHAT_MP_APP_ID=wxxxxxxx
WECHAT_MP_APP_SECRET=your-secret
WECHAT_MP_TOKEN=your-token
WECHAT_MP_AES_KEY=your-aes-key
WECHAT_MP_WEBHOOK_PATH=/wechat-mp
WECHAT_MP_MESSAGE_MODE=plain
# WECHAT_MP_REPLY_MODE=passive

# 企业微信自建应用 (WeCom App - 可接入个人微信)
WECOM_APP_ENABLED=false
WECOM_APP_CORP_ID=wwxxxxxx
WECOM_APP_CORP_SECRET=your-secret
WECOM_APP_AGENT_ID=1000001
WECOM_APP_TOKEN=your-token
WECOM_APP_AES_KEY=your-aes-key
WECOM_APP_WEBHOOK_PATH=/wecom-app

# 微信客服 (WeCom KF - 外部微信用户接入)
WECOM_KF_ENABLED=false
WECOM_KF_CORP_ID=wwxxxxxx
WECOM_KF_CORP_SECRET=your-kf-secret
WECOM_KF_OPEN_KFID=wkxxxxxx
WECOM_KF_TOKEN=your-token
WECOM_KF_AES_KEY=your-aes-key
WECOM_KF_WEBHOOK_PATH=/wecom-kf

# 微信 App (WeChat App - 基于 wechatbot SDK 的个人微信协议接入)
WECHAT_APP_ENABLED=false
WECHAT_APP_STORAGE=file
WECHAT_APP_STORAGE_DIR=./data/wechatbot
WECHAT_APP_LOG_LEVEL=info
